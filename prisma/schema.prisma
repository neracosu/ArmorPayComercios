// ArmorPay Cloud — esquema multi-tenant.
//
// Regla estructural: TODO modelo que contenga datos de un comercio lleva
// `organizationId`. Sin esa columna, la extensión de Prisma que fuerza el
// aislamiento (`src/lib/prisma.ts`) no tiene qué filtrar y el modelo queda
// expuesto entre tenants — que es exactamente el bug R-16 del proyecto viejo.
// Si agregás un modelo nuevo con datos de comercio y NO le ponés
// `organizationId`, estás abriendo una fuga.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  // En cPanel el usuario no puede crear bases por SQL: la shadow se crea a mano
  // con `uapi Mysql create_database`. Solo la usa `migrate dev` en desarrollo.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN // nosotros: operamos la plataforma
  PLATFORM_REVIEWER // empleado nuestro: revisa expedientes y guía las altas — sin poderes de activación ni de llaves
  ORG_ADMIN // dueño del comercio
  OPERATOR // caja
}

enum OrgStatus {
  REGISTRADA // se registró, faltan recaudos
  RECAUDOS_COMPLETOS // cargó todo, esperando nuestra revisión
  ENVIADA_AL_BANCO // solicitud de afiliación cursada
  CERTIFICACION // el banco afilió; falta certificar la integración
  ACTIVA // opera normalmente
  RECHAZADA
  SUSPENDIDA
}

enum Plan {
  PRUEBA // captación: piso chico, invita a elegir plan
  COMERCIO
  CADENA
}

enum KeyStatus {
  SIN_LLAVE
  CARGADA // pegada, todavía no probada contra el banco
  VERIFICADA // echo-test GES0000
  INVALIDA // el banco la rechazó
}

/// Tenant. Raíz de todo dato de comercio.
model Organization {
  id          String    @id @default(cuid())
  slug        String    @unique // subdominio / identificador en URLs
  razonSocial String // la certificada ante el banco — el checkout muestra ESTA
  rif         String    @unique // normalizado sin guiones: J500198175
  status      OrgStatus @default(REGISTRADA)
  plan        Plan      @default(PRUEBA)

  // A quién llamar cuando algo pasa con este comercio. Se precarga del lead
  // (conversión manual) o del registro self-service, y lo edita tanto la
  // plataforma (ficha) como el propio dueño (perfil). Sin esto, contactar a
  // un cliente exigía ir a la solicitud original o a la base a mano.
  contactoNombre   String?
  contactoTelefono String?
  contactoEmail    String?
  // Notas de la relación (solo plataforma, la revisora incluida): acuerdos,
  // números de trámite con el banco, contexto que no cabe en un campo.
  notasInternas    String? @db.Text

  // Aceptación de términos en el registro self-service: cuándo y qué versión
  // estaba vigente. Los comercios de alta manual no la llevan — su relación
  // se rige por el acuerdo comercial directo.
  terminosAceptadosAt DateTime?
  terminosVersion     String?

  // Llave de Trabajo del BDT. El banco la emite POR RIF, no por cuenta: una
  // organización con varias cuentas comparte llave. Campo de SOLO ESCRITURA:
  // se pega y nunca se vuelve a leer completa desde la interfaz.
  authKeyEnc     String?   @db.Text // AES-256-GCM
  authKeyHint    String? // "DDF…755" — se guarda al grabar para no descifrar al pintar
  authKeyStatus  KeyStatus @default(SIN_LLAVE)
  authKeyVersion Int       @default(1) // permite rotar la clave de cifrado sin downtime
  lastVerifiedAt DateTime?

  // Afiliación C2P «Botón de Pago» del Tesoro. La identidad ante el banco es
  // codAfiliado + rif (el servicio no usa secreto), así que acá no hay cifrado:
  // el gate operativo es `btC2pEnabled`, que solo se prende cuando el banco
  // confirma la afiliación del comercio.
  // `btC2pVerifiedAt` no lo pone nadie a mano: lo estampa el primer cobro real
  // aprobado (codres C2P0000) — el banco no ofrece cómo validar un afiliado
  // sin ejecutar un cobro. `btC2pUltimoRebote` guarda el último codres de la
  // familia afiliación (C2P0019, C2P0076…) para alertar en la ficha; un cobro
  // aprobado lo limpia.
  btCodAfiliado     String?
  btC2pEnabled      Boolean   @default(false)
  btC2pVerifiedAt   DateTime?
  btC2pUltimoRebote String?

  // Credenciales BT del comercio ante el Tesoro: Cod_Socio + app_user +
  // app_key (las emite el banco por empresa; NO son el codAfiliado C2P de
  // arriba). Cod_Socio y app_user son identificadores; la app_key es el
  // secreto: cifrada, de solo escritura y con pista, igual que la Llave BDT.
  // Las carga el comercio si el banco ya se las entregó, o nosotros desde la
  // ficha si gestionamos su afiliación. El gate de activación exige cada
  // credencial SOLO si el comercio tiene cuentas de ese banco.
  btCodSocio       String?
  btAppUser        String?
  btAppKeyEnc      String?   @db.Text
  btAppKeyHint     String?
  btCredStatus     KeyStatus @default(SIN_LLAVE)
  btCredVerifiedAt DateTime?

  // Los DOS escenarios de llegada: el comercio ya trae su afiliación bancaria
  // (llave, credenciales) o nos pide gestionarla nosotros contra el banco.
  // null = todavía no eligió. La promesa comercial es la solución completa:
  // nadie queda fuera por no conocer el trámite bancario.
  gestionBanco GestionBanco?

  // Logo del comercio: la cara de su marca en el panel de cajas y en /pay.
  // Vive EN la base (no en disco) para que el backup de la base se lleve todo.
  // Solo raster (png/jpg/webp, verificado por bytes mágicos): un SVG puede
  // llevar scripts y se serviría desde nuestro dominio. ≤512 KB.
  logo          Bytes?    @db.MediumBlob
  logoMime      String?
  logoUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  branches         Branch[]
  accounts         BankAccount[]
  shifts           Shift[]
  claims           PaymentClaim[]
  transactions     BankTransaction[]
  keyEvents        AuthKeyEvent[]
  apiKeys          ApiKey[]
  checkoutIntents  CheckoutIntent[]
  webhookEndpoints WebhookEndpoint[]
  recaudos         Recaudo[]
  validations      ValidationRequest[]

  @@index([status])
}

/// Bitácora de acciones administrativas de la plataforma: quién activó, quién
/// borró, quién aprobó qué. La columna se llama `targetOrgId` y NO
/// `organizationId` A PROPÓSITO: la extensión de tenant protege todo modelo
/// con esa columna, y esta bitácora es DE LA PLATAFORMA — se lee sin contexto
/// de tenant y debe sobrevivir al borrado del comercio (por eso tampoco lleva
/// FK; `detail` guarda razón social y RIF cuando el objetivo es una org).
model PlatformEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  /// Username del actor al momento del acto (no depende de que el user siga).
  actor       String
  targetOrgId String?
  action      String
  detail      String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetOrgId, createdAt])
  @@index([action, createdAt])
}

/// Bitácora de la Llave de Trabajo. Visible para el comercio: es su credencial.
model AuthKeyEvent {
  id             String   @id @default(cuid())
  organizationId String
  action         String // cargada | reemplazada | rotada | verificada | invalidada
  actorUserId    String? // null = proceso automático
  detail         String?  @db.Text
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model User {
  id             String  @id @default(cuid())
  organizationId String? // null SOLO para PLATFORM_ADMIN, que no pertenece a un comercio
  username       String  @unique
  passwordHash   String
  name           String
  email          String? // contacto del registro self-service; las cajas no lo llevan
  role           Role    @default(OPERATOR)
  isActive       Boolean @default(true)
  tokenVersion   Int     @default(0) // bump = invalida todos los JWT del user al instante

  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shifts       Shift[]
  claims       PaymentClaim[]
  validations  ValidationRequest[]

  @@index([organizationId])
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  shifts       Shift[]
  claims       PaymentClaim[]

  // Únicos POR organización: dos comercios distintos pueden tener su "Principal".
  @@unique([organizationId, code])
  @@unique([organizationId, name])
}

model BankAccount {
  id             String   @id @default(cuid())
  organizationId String
  accountNumber  String   @unique // 20 dígitos — único global: una cuenta pertenece a un solo comercio
  banco          String   @default("BDT") // banco donde vive la cuenta: BDT | BT
  alias          String
  merchantCode   String?  @unique
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  validations  ValidationRequest[]

  @@index([organizationId])
}

/// Créditos que el banco notificó (webhook o estado de cuenta en vivo).
///
/// `organizationId` está DESNORMALIZADO a propósito: el banco identifica el
/// pago por `numeroCuenta` y nada más. Sin esta columna, la extensión de
/// Prisma no tendría qué filtrar justo en la tabla que guarda monto, banco y
/// cédula del pagador de TODOS los comercios. Lo resuelve el gateway en la
/// ingesta, que ya sabe a qué organización pertenece cada cuenta.
model BankTransaction {
  id               String   @id @default(cuid())
  organizationId   String
  // Banco RECEPTOR del crédito (BDT | BT). Default "BDT" = backfill correcto:
  // todo lo insertado antes de esta columna era BDT (las filas BT caían en
  // `sinComercio` porque sus cuentas no existían como BankAccount).
  banco            String   @default("BDT")
  numeroCuenta     String
  montoTransaccion String
  fechaTransaccion String // yyyy-mm-dd
  horaTransaccion  String // hhmmss
  referencia       String
  tipo             String // CREDITO | DEBITO
  descripcion      String   @db.Text
  desdeBanco       String
  tipoProd         String // CELE | CNTA
  desdeCuenta      String
  desdeDni         String
  origen           String // webhook | estado_de_cuenta
  receivedAt       DateTime @default(now())
  rawPayload       String   @db.MediumText

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  claims          PaymentClaim[]
  checkoutIntents CheckoutIntent[]

  @@unique([numeroCuenta, referencia, fechaTransaccion, horaTransaccion], name: "uniq_tx")
  @@index([organizationId, receivedAt])
  @@index([organizationId, referencia])
  @@index([organizationId, banco])
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model Shift {
  id             String      @id @default(cuid())
  organizationId String
  userId         String
  branchId       String
  status         ShiftStatus @default(OPEN)
  attendant      String?
  openedAt       DateTime    @default(now())
  closedAt       DateTime?
  closingNote    String?     @db.Text
  totalCount     Int?
  totalAmount    Decimal?    @db.Decimal(18, 2)
  // "un solo turno OPEN por caja" sin partial-unique: = userId mientras OPEN,
  // null al cerrar (MySQL permite múltiples NULL en UNIQUE).
  openKey        String?     @unique

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  claims       PaymentClaim[]

  @@index([organizationId, openedAt])
  @@index([userId, openedAt])
}

enum ClaimSource {
  LOOKUP
  ONLINE
  CHECKOUT
}

/// Ledger de cobros. `primaryKey @unique` = un solo cobro primario por pago
/// (antifraude one-time redemption, arbitrado por la base, race-safe).
///
/// Es el árbitro COMPARTIDO entre la caja y el checkout — no hay antifraude
/// paralelo (lección madre del panel interno). Un cobro de checkout no tiene
/// caja: por eso `shiftId`/`userId`/`branchId` son nullable y `source` lo
/// distingue. Camino REFERENCIA: `primaryKey = bankTransaction.id` (la misma
/// clave que usa la caja → la base garantiza que un pago cobrado en caja no
/// confirma un checkout ni al revés). Camino C2P (sin BankTransaction):
/// `primaryKey = "c2p:" + organizationId + ":" + referencia` (clave sintética).
model PaymentClaim {
  id                String      @id @default(cuid())
  organizationId    String
  shiftId           String? // null = cobro de checkout, sin caja
  userId            String?
  branchId          String?
  source              ClaimSource @default(LOOKUP)
  bankTransactionId   String?
  checkoutIntentId    String?     @unique
  // Cobro nacido de una consulta online o de un C2P de caja. @unique: una
  // validación respalda UN cobro primario (los duplicados van sin vínculo).
  validationRequestId String?     @unique
  reference         String
  amount            Decimal     @db.Decimal(18, 2)
  numeroCuenta      String
  payerBank         String?
  fechaTransaccion  String?
  horaTransaccion   String?
  isDuplicate       Boolean     @default(false)
  duplicateOfId     String?
  ackReason         String?     @db.Text
  claimedAt         DateTime    @default(now())
  primaryKey        String?     @unique

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shift           Shift?           @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  bankTransaction   BankTransaction?   @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  checkoutIntent    CheckoutIntent?    @relation(fields: [checkoutIntentId], references: [id], onDelete: Restrict)
  validationRequest ValidationRequest? @relation(fields: [validationRequestId], references: [id], onDelete: Restrict)
  duplicateOf     PaymentClaim?    @relation("Dup", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates      PaymentClaim[]   @relation("Dup")

  @@index([organizationId, claimedAt])
  @@index([shiftId])
  @@index([bankTransactionId])
}

enum ValidationType {
  VAL_P2P // Pago Móvil recibido en una cuenta afiliada (consulta BDT)
  VAL_P2P_CC // Pago Móvil recibido en un código de comercio (consulta BDT)
  VAL_TRANSFER // Transferencia / crédito inmediato (consulta BDT)
  VAL_TRANSACTION // Movimiento genérico por fecha/monto/ref (consulta BDT, NO cobrable)
  BT_C2P // Cobro «Botón de Pago» del Tesoro ejecutado desde la caja
}

/// Bitácora de consultas en línea al banco y cobros C2P de caja — el
/// equivalente del ValidationRequest del panel interno. Cada intento queda,
/// exitoso o no: es la evidencia de qué se le preguntó al banco y qué
/// respondió. Un resultado exitoso y cobrable respalda UN PaymentClaim
/// (flujo ONLINE, mismo árbitro `primaryKey` de siempre).
model ValidationRequest {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  type           ValidationType
  accountId      String? // cuenta consultada (null en VAL_P2P_CC, que va por comercio)
  merchantCode   String?
  date           String // YYYYMMDD tecleado por la caja (en C2P: fecha local del cobro)
  amount         String
  reference      String // en C2P la emite el banco al aprobar; vacía en rechazo
  bankCode       String?
  phone          String?
  dni            String?
  trace          String // trace BDT o numeroLote C2P — correlación con el banco
  responseCode   String
  responseMsg    String
  rawResponse    String         @db.Text
  durationMs     Int
  createdAt      DateTime       @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  account      BankAccount?  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  claim        PaymentClaim?

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────
// Checkout (Fase 2 de la guía). Todos con `organizationId`: quedan
// protegidos solos por la extensión DMMF.
// ─────────────────────────────────────────────────────────────────

/// Credencial de la API v1. El key completo se muestra UNA sola vez al
/// crearlo; acá solo viven el hash y el prefijo de lookup.
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String // "producción tienda web"
  prefix         String    @unique // "ak_live_" + 8 chars visibles — lookup
  hashedKey      String // sha256 del key completo
  isActive       Boolean   @default(true)
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum IntentStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
}

enum IntentMethod {
  REFERENCIA
  C2P
}

/// Una intención de cobro del carrito del comercio. El monto lo fija el
/// servidor al crearla y JAMÁS se compara contra lo que declare el cliente
/// final — solo contra lo que registró el banco.
model CheckoutIntent {
  id             String        @id @default(cuid())
  organizationId String
  apiKeyId       String
  externalRef    String // id del pedido en el carrito del comercio
  amountVES      Decimal       @db.Decimal(18, 2)
  // Cobro preciado en USD (Fase 6): amountVES se congela con la tasa BCV del
  // momento de crear, y la validación acepta también USD × tasa vigente
  // (candidatos con tolerancia). Nulos en un cobro VES puro.
  amountUSD         Decimal? @db.Decimal(18, 2)
  exchangeRateUsed  Decimal? @db.Decimal(18, 4)
  exchangeRateId    String?
  concepto       String // ≤40, saneado — viaja al C2P
  method         IntentMethod?
  status         IntentStatus  @default(PENDING)
  idempotencyKey String
  // resultado
  bankTransactionId String? // camino REFERENCIA
  c2pReferencia     String? // camino C2P (referencia bancaria)
  c2pCodres         String?
  gatewayResponse   String?  @db.Text // crudo del banco — evidencia forense
  overpaidVES       Decimal? @db.Decimal(18, 2)
  expiresAt      DateTime
  confirmedAt    DateTime?
  createdAt      DateTime      @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  claim           PaymentClaim?

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  // Para el housekeeping del worker: barrer PENDING vencidos cross-tenant.
  @@index([status, expiresAt])
}

/// Adónde avisamos al comercio. El secreto de firma se cifra igual que la
/// AuthKey (AES-256-GCM con APP_SECRET).
model WebhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  secretEnc      String   @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED_RETRYING
  DEAD
}

/// Cola de entregas de webhooks al comercio (la procesa el worker, Fase 4).
/// Sin FKs a propósito: tabla de alto volumen, append + update de estado.
model WebhookDelivery {
  id             String         @id @default(cuid())
  organizationId String
  endpointId     String
  intentId       String
  payload        String         @db.Text
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  nextRetryAt    DateTime       @default(now())
  lastError      String?        @db.Text
  createdAt      DateTime       @default(now())

  @@index([status, nextRetryAt])
  @@index([organizationId, createdAt])
}

/// Bitácora append-only de la API + base del rate limit persistido (patrón
/// Lead). Sin FKs a propósito: nada la borra en cascada — es evidencia.
model ApiEvent {
  id             String   @id @default(cuid())
  organizationId String
  apiKeyId       String?
  intentId       String?
  action         String // intent_created | ref_validated | ref_rejected | c2p_ok | c2p_fail | ...
  detail         String?  @db.Text // SIEMPRE enmascarado
  clientIp       String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([clientIp, createdAt]) // rate limit por IP
  @@index([apiKeyId, createdAt]) // rate limit por key
}

enum LeadEstado {
  NUEVO
  CONTACTADO
  CONVERTIDO // ya tiene su Organization creada
  DESCARTADO
}

/// Solicitud de propuesta que llega desde la portada pública.
///
/// OJO: aunque nace sin comercio, SÍ declara `organizationId` (nullable, por
/// la trazabilidad de conversión de abajo) — y eso basta para que la extensión
/// DMMF lo trate como modelo de tenant y exija contexto. El código que lo
/// maneja opera con `runAsPlatform`/cliente crudo porque es un modelo de
/// plataforma que solo ve el `PLATFORM_ADMIN`.
model Lead {
  id             String     @id @default(cuid())
  empresa        String
  rif            String?
  contacto       String
  email          String
  telefono       String?
  cajas          Int?
  sucursales     Int?
  banco          String?
  mensaje        String?    @db.Text
  estado         LeadEstado @default(NUEVO)
  notaInterna    String?    @db.Text
  // Trazabilidad del alta: a qué comercio se convirtió y quién lo convirtió.
  organizationId String?
  convertidoPor  String?
  convertidoAt   DateTime?
  // Para limitar abuso del formulario público.
  clientIp       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([estado, createdAt])
  @@index([clientIp, createdAt])
}

enum GestionBanco {
  TRAE_AFILIACION // ya tiene todo con el banco: pega su llave y sigue
  GESTIONAMOS // la plataforma tramita la afiliación por él (full service)
}

enum RecaudoStatus {
  PENDIENTE // subido, esperando nuestra revisión
  APROBADO
  RECHAZADO // con nota del motivo — el comercio puede volver a subir
}

/// Documento del expediente de afiliación (RIF, registro mercantil, cédula
/// del representante…). El comercio los sube desde su panel de activación y
/// nosotros los revisamos desde la ficha. Con `organizationId` → protegido
/// solo por la extensión. El archivo vive en la base, igual que el logo:
/// el backup se lleva el expediente completo.
model Recaudo {
  id             String        @id @default(cuid())
  organizationId String
  tipo           String // rif | registro_mercantil | cedula_representante | otro
  nombre         String // nombre del archivo original, para reconocerlo
  archivo        Bytes         @db.MediumBlob
  mime           String
  status         RecaudoStatus @default(PENDIENTE)
  nota           String?       @db.Text // motivo de rechazo / observación nuestra
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Un documento por tipo: volver a subir REEMPLAZA (el expediente no acumula
  // versiones viejas de un RIF vencido).
  @@unique([organizationId, tipo])
  @@index([organizationId, createdAt])
}

/// Tasa BCV registrada. Modelo de PLATAFORMA (sin organizationId a propósito):
/// la tasa es una sola para todos. Cada consulta exitosa a la fuente deja una
/// fila — el historial ES la auditoría de qué tasa se usó y cuándo, y la fila
/// más reciente es el caché. JAMÁS una tasa hardcodeada: sin fila utilizable,
/// el cobro en USD falla explícito.
model ExchangeRate {
  id        String   @id @default(cuid())
  rate      Decimal  @db.Decimal(18, 4) // VES por 1 USD
  source    String // dolarapi | pydolarve
  fetchedAt DateTime @default(now())

  @@index([fetchedAt])
}

/// Config de plataforma (no de tenant). NO lleva organizationId a propósito.
/// OJO: el SaaS no lo toca, pero NO está muerto — el gateway persiste acá su
/// cursor del tail (`gateway/index.ts`). Antes de "limpiarlo", grep en
/// gateway/ y worker/, no solo en src/.
model PlatformSetting {
  key       String   @id
  value     String   @db.Text
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
